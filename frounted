<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tathastu - Student PGs & Mess Finder</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 20px; background: #f4f4f9; color: #333; }
        h1, h2 { color: #2c3e50; }
        .container { display: flex; gap: 20px; flex-wrap: wrap; }
        .card { background: white; padding: 15px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); width: 300px; margin-bottom: 15px; }
        .card h3 { margin-top: 0; color: #3498db; }
        button { background: #2ecc71; color: white; border: none; padding: 8px 12px; border-radius: 4px; cursor: pointer; }
        button:hover { background: #27ae60; }
    </style>
</head>
<body>

    <h1>Tathastu Accommodations & Mess Finder</h1>

    <h2>Available PGs</h2>
    <div id="pg-container" class="container">Loading PGs...</div>

    <h2>Available Mess Options</h2>
    <div id="mess-container" class="container">Loading Mess...</div>

    <script>
        const API_URL = 'http://localhost:3000';

        // 1. Fetch PGs
        fetch(`${API_URL}/api/pgs`)
            .then(res => res.json())
            .then(pgs => {
                const container = document.getElementById('pg-container');
                container.innerHTML = '';
                pgs.forEach(pg => {
                    const card = document.createElement('div');
                    card.className = 'card';
                    card.innerHTML = `
                        <h3>${pg.name}</h3>
                        <p><strong>Area:</strong> ${pg.area}</p>
                        <p><strong>College:</strong> ${pg.college}</p>
                        <p><strong>Rent:</strong> ₹${pg.rent}/month</p>
                        <p><strong>Gender:</strong> ${pg.gender}</p>
                        <p>⭐ ${pg.rating} (${pg.reviews} reviews)</p>
                        <button onclick="bookVisit('${pg.name}')">Book Visit</button>
                    `;
                    container.appendChild(card);
                });
            })
            .catch(err => {
                console.error('Error:', err);
                document.getElementById('pg-container').innerText = 'Failed to load PGs.';
            });

        // 2. Fetch Mess
        fetch(`${API_URL}/api/mess`)
            .then(res => res.json())
            .then(messList => {
                const container = document.getElementById('mess-container');
                container.innerHTML = '';
                messList.forEach(mess => {
                    const card = document.createElement('div');
                    card.className = 'card';
                    card.innerHTML = `
                        <h3>${mess.name}</h3>
                        <p><strong>Area:</strong> ${mess.area}</p>
                        <p><strong>Monthly Price:</strong> ₹${mess.monthly_price}</p>
                        <p><strong>Speciality:</strong> ${mess.special}</p>
                    `;
                    container.appendChild(card);
                });
            })
            .catch(err => {
                console.error('Error:', err);
                document.getElementById('mess-container').innerText = 'Failed to load Mess options.';
            });

        // 3. Book Visit Handler
        function bookVisit(pgName) {
            const day = prompt("Enter day for visit (e.g., Saturday):", "Saturday");
            const time = prompt("Enter time for visit (e.g., 4:00 PM):", "4:00 PM");

            if (!day || !time) return;

            fetch(`${API_URL}/api/visits`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ pgName, day, time })
            })
            .then(res => res.json())
            .then(data => alert(data.message))
            .catch(err => console.error('Error booking visit:', err));
        }
    </script>
</body>
</html>
